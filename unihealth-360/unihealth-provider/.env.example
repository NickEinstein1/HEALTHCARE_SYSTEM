# UniHealth Provider — environment variables
# Copy this to .env and fill in real values before running

# API
EXPO_PUBLIC_API_BASE_URL=https://api.unihealth360.ke
EXPO_PUBLIC_APP_VERSION=1.0.0

# Keycloak
EXPO_PUBLIC_KEYCLOAK_URL=https://auth.unihealth360.ke
EXPO_PUBLIC_KEYCLOAK_REALM=unihealth
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=unihealth-provider-app

# M-Pesa (Daraja API — server-side only, never put consumer key in client app)
# These are handled by the backend Premium service, not the mobile app directly.
# MPESA_CONSUMER_KEY=...  <-- NEVER in mobile app
# MPESA_CONSUMER_SECRET=... <-- NEVER in mobile app

# EAS / OTA updates (fill after running: eas init)
EXPO_PUBLIC_EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
