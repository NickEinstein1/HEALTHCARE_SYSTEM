# Backend environment — copy to .env before running docker compose up

# Database
DB_PASSWORD=changeme_strong_password_here

# Keycloak admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin

# JWT signing (generate: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_32_BYTE_HEX_SECRET

# M-Pesa Daraja API (production values from Safaricom developer portal)
MPESA_CONSUMER_KEY=REPLACE_WITH_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=REPLACE_WITH_SHORTCODE
MPESA_PASSKEY=REPLACE_WITH_PASSKEY
MPESA_CALLBACK_URL=https://api.unihealth360.ke/insurance/premium/mpesa/callback

# KRA iTax (for remittance file generation)
KRA_TAXPAYER_PIN=REPLACE_WITH_EMPLOYER_KRA_PIN
