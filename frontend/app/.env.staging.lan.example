# LAN staging — replace 192.168.1.42 with this laptop's IP (see docs/runbook-staging.md).
# Keycloak must be started with docker-compose.staging.lan.yml and LAN_HOST set.

VITE_API_BASE_URL=http://192.168.1.42:8100

VITE_OIDC_ENABLED=true
VITE_OIDC_ISSUER=http://192.168.1.42:8180/realms/unihealth
VITE_OIDC_CLIENT_ID=unihealth-spa
