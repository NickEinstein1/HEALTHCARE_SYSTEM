# Optional: gateway origin when SPA is hosted separately from the API (e.g. CDN + cross-origin gateway).
# Leave unset in local dev — Vite proxies API paths & WebSockets to localhost:8000 (see vite.config.ts).
#
# Examples:
# Staging Docker stack (recommended): gateway on :8100
# VITE_API_BASE_URL=http://localhost:8100
# Local split dev (run_full_flow.sh): gateway on :8000
# VITE_API_BASE_URL=http://localhost:8000
# VITE_DEV_PROXY_TARGET=http://localhost:8100
# VITE_API_BASE_URL=https://api.yourfacility.example.org

# OIDC (staging Keycloak) — staff sign-in uses password grant; API calls send Bearer token.
# VITE_OIDC_ENABLED=true
# VITE_OIDC_ISSUER=http://localhost:8180/realms/unihealth
# VITE_OIDC_CLIENT_ID=unihealth-spa
