# Multi-stage Vite build for VPS nginx static hosting
# Build context must be repo root (see infra/docker-compose.vps.yml) so shared/ is available.
FROM node:22-alpine AS build
WORKDIR /workspace/frontend/app

COPY frontend/app/package.json frontend/app/package-lock.json* ./
COPY frontend/app/ .
COPY shared /workspace/shared

ARG VITE_API_BASE_URL
ARG VITE_OIDC_ENABLED=true
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID=unihealth-spa
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_OIDC_ENABLED=$VITE_OIDC_ENABLED \
    VITE_OIDC_ISSUER=$VITE_OIDC_ISSUER \
    VITE_OIDC_CLIENT_ID=$VITE_OIDC_CLIENT_ID

# Always install devDependencies in-image; host node_modules must never be copied (see .dockerignore).
ENV CI=true
RUN npm ci --include=dev && npm run build

FROM nginx:1.27-alpine
COPY --from=build /workspace/frontend/app/dist /usr/share/nginx/html
COPY frontend/app/nginx.vps.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
