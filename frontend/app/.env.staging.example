# Staging laptop profile — copy via: ../../scripts/setup_frontend_staging.sh
# Gateway from infra/docker-compose.staging.yml (host port 8100)

# Leave unset in dev — Vite proxies /legal, /fhir, /ai, … to the gateway (see vite.config.ts).
# VITE_API_BASE_URL=http://localhost:8100

# Set only for production builds (npm run build) when the UI is served separately from the API:
# VITE_API_BASE_URL=https://api.yourfacility.example.org

# Optional: direct cross-origin calls in dev (not recommended — use proxy instead)
# VITE_API_FORCE_DIRECT=true
# VITE_API_BASE_URL=http://localhost:8100

VITE_OIDC_ENABLED=true
VITE_OIDC_ISSUER=http://localhost:8180/realms/unihealth
VITE_OIDC_CLIENT_ID=unihealth-spa

# Vite dev proxy target when VITE_API_BASE_URL is unset (default :8100)
# VITE_DEV_PROXY_TARGET=http://localhost:8100
