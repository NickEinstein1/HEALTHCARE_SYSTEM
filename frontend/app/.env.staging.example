# Staging laptop profile — copy via: ../../scripts/setup_frontend_staging.sh
# Gateway from infra/docker-compose.staging.yml (host port 8100)

VITE_API_BASE_URL=http://localhost:8100

VITE_OIDC_ENABLED=true
VITE_OIDC_ISSUER=http://localhost:8180/realms/unihealth
VITE_OIDC_CLIENT_ID=unihealth-spa

# Optional: point Vite dev proxy at staging when VITE_API_BASE_URL is unset
# VITE_DEV_PROXY_TARGET=http://localhost:8100
