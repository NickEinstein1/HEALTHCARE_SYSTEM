# UniHealth VPS production — copy to infra/.env.vps (NEVER commit)
#
# DNS (point A/AAAA records at your VPS IP):
#   APP_HOSTNAME  → web SPA
#   API_HOSTNAME  → ehr-api
#   AUTH_HOSTNAME → Keycloak

APP_HOSTNAME=app.yourdomain.com
API_HOSTNAME=api.yourdomain.com
AUTH_HOSTNAME=auth.yourdomain.com

# Supabase Session pooler (clinical DB) — IPv4
EHR_POSTGRES_DSN=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require

# Secrets — generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_REDIS
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KC_DB
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN
EHR_PATIENT_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SESSION_SECRET

# OIDC
EHR_OIDC_AUDIENCE=account

# M-Pesa (leave empty until live paybill ready; simulate is forced off in production)
EHR_MPESA_CONSUMER_KEY=
EHR_MPESA_CONSUMER_SECRET=
EHR_MPESA_PASSKEY=
EHR_MPESA_C2B_PASSKEY=
EHR_MPESA_SHORTCODE=
