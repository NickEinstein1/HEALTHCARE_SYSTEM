# TLS reverse proxy in front of ehr-gateway (Phase 2 production pattern)
# Place behind certbot / ACM / hospital PKI. Adjust server_name and upstream.

upstream unihealth_gateway {
    server 127.0.0.1:8100;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name api.unihealth.example;

    ssl_certificate     /etc/ssl/certs/unihealth-api.pem;
    ssl_certificate_key /etc/ssl/private/unihealth-api.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://unihealth_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /ai/ws/ {
        proxy_pass http://unihealth_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

server {
    listen 80;
    server_name api.unihealth.example;
    return 301 https://$host$request_uri;
}
