# Copy to infra/.env.staging for docker compose --env-file
POSTGRES_PASSWORD=ehr_staging_password
KEYCLOAK_ADMIN_PASSWORD=admin

# Kenya MOH facility directory (api.kmhfr.health.go.ke). Demo fallback works without MOH credentials.
KMHFL_BASE_URL=https://api.kmhfr.health.go.ke
KMHFL_USE_DEMO_FALLBACK=true
# KMHFL_API_TOKEN=
# KMHFL_USERNAME=
# KMHFL_PASSWORD=

# Clinical AI (server-side keys only — never expose to frontend)
