# Supabase live database — UniHealth EHR (example only — never commit real passwords)
#
# Prefer Session pooler (IPv4). Direct db.*.supabase.co may be IPv6-only on free tier.
#
# EHR_POSTGRES_DSN=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
#
# Then:
#   ./scripts/setup_supabase_db.sh
#   cd ehr-api && .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
#   (loads ehr-api/.env.supabase.local if present)

EHR_POSTGRES_DSN=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres?sslmode=require
EHR_INFRA_OPTIONAL=false
EHR_REDIS_URL=redis://localhost:6379/0
EHR_CORS_EXTRA_ORIGINS=
