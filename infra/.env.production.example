# Production overlay — copy to infra/.env.production (do not commit secrets)
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Gateway production profile (also set in K8s ConfigMap)
EHR_DEPLOYMENT_ENV=production
EHR_CONSENT_MODE=strict
EHR_INFRA_OPTIONAL=false
EHR_OIDC_ENABLED=true
EHR_OIDC_ALLOW_HEADER_FALLBACK=false
EHR_OIDC_ISSUER_URL=https://auth.example/realms/unihealth
EHR_OIDC_JWKS_URL=https://auth.example/realms/unihealth/protocol/openid-connect/certs
EHR_OIDC_AUDIENCE=unihealth-gateway

# Patient OTP (SMS provider wired later; never leave simulate on in production)
EHR_OTP_SIMULATE=false
EHR_PATIENT_SESSION_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# M-Pesa (server-side only)
EHR_MPESA_SIMULATE=false
EHR_MPESA_CONSUMER_KEY=
EHR_MPESA_CONSUMER_SECRET=
EHR_MPESA_PASSKEY=
EHR_MPESA_C2B_PASSKEY=
EHR_MPESA_SHORTCODE=
EHR_MPESA_CALLBACK_BASE_URL=https://api.example

# Web CORS (comma-separated production origins)
EHR_CORS_EXTRA_ORIGINS=https://app.example

