# Production overlay — copy to infra/.env.production (do not commit secrets)
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Gateway production profile (also set in K8s ConfigMap)
EHR_DEPLOYMENT_ENV=production
EHR_CONSENT_MODE=strict
EHR_OIDC_ENABLED=true
EHR_OIDC_ALLOW_HEADER_FALLBACK=false
EHR_OIDC_ISSUER_URL=https://auth.example/realms/unihealth
EHR_OIDC_JWKS_URL=https://auth.example/realms/unihealth/protocol/openid-connect/certs
EHR_OIDC_AUDIENCE=unihealth-gateway
