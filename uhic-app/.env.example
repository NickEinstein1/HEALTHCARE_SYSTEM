# Copy to `.env` before `npx expo start`
EXPO_PUBLIC_API_BASE_URL=http://localhost:8100
EXPO_PUBLIC_DEFAULT_ROLE=claims_adjudicator
EXPO_PUBLIC_DEFAULT_FACILITY_ID=FAC-A

# Android emulator: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8100
# Physical device on LAN: EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8100
