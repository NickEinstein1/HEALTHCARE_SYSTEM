# Copy to `.env` before `npx expo start` (Expo loads this automatically).
# All app settings use the EXPO_PUBLIC_ prefix so they are available in the bundle.

# Staging gateway — same as web frontend (VITE_API_BASE_URL)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8100

# Default FHIR patient ID for sign-in / dashboard
EXPO_PUBLIC_DEFAULT_PATIENT_ID=P001

# Optional OIDC password grant (pilot)
# EXPO_PUBLIC_OIDC_ENABLED=true
# EXPO_PUBLIC_OIDC_ISSUER=http://localhost:8180/realms/unihealth
# EXPO_PUBLIC_OIDC_CLIENT_ID=unihealth-spa

# Android emulator: EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8100
# Physical device on LAN: EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:8100
